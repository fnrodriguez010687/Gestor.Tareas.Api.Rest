# ==========================================
# Archivos generados por la compilación (Build)
# ==========================================
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Resultados de pruebas (xUnit, MSTest, NUnit)
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage.json

# ==========================================
# Archivos de Visual Studio
# ==========================================
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# Archivos de configuración del proyecto
project.lock.json
project.fragment.lock.json
artifacts/

# ==========================================
# Archivos de VS Code
# ==========================================
# Ignoramos la carpeta .vscode por defecto, 
# pero si quieres compartir configuraciones del equipo, 
# podrías quitar esta línea y hacer un "git add -f .vscode/launch.json"
.vscode/

# ==========================================
# Archivos de JetBrains (Rider / ReSharper)
# ==========================================
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ==========================================
# Bases de Datos Locales (Muy importante)
# ==========================================
# Como usas SQLite (o si usas LocalDB), no queremos subir el archivo de la BD
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf

# ==========================================
# Secretos y Configuraciones Locales
# ==========================================
# Archivos de configuración específicos del entorno local
appsettings.*.local.json
appsettings.Local.json
*.secrets.json
*.pfx
*.snk

# ==========================================
# Archivos del Sistema Operativo
# ==========================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

